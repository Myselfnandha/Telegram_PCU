# Telegram Web Uploader - Git Ignore Policy

# Python Environments & Caches
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Sensitive Telegram Credentials & Sessions
.env
*.env
!.env.example
backend/.env
backend/*.env
!backend/.env.example
backend/sessions/*.session
backend/sessions/*.session-journal
backend/sessions/*.session*
*.session
.agents
*.agents
# Local Database, Logs & Storage
backend/data/*.db*
backend/data/*.sqlite*
backend/data/*.sqlite3
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.log*
backend/data/*.pid
backend/data/subtitles/*
!backend/data/subtitles/.gitkeep
backend/data/bin/*
!backend/data/bin/.gitkeep
backend/backups/
*.db
*.sqlite3
*.log*
*.pid
*.zip
tg_power_suite_v2.0_vlc_stability_patch/
ZeroGravity
*ZeroGravity
# Temporary Buffers & Download Directories
backend/temp_uploads/*
!backend/temp_uploads/.gitkeep
backend/downloads/*
!backend/downloads/.gitkeep
backend/data/stream_cache/*
!backend/data/stream_cache/.gitkeep

