# Telegram API Credentials
# Get your API ID and API Hash from https://my.telegram.org (under API development tools)
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here
TG_PHONE=+1234567890

# Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=telegram-web-uploader-secret-key

# Storage & Upload Thresholds (Bytes)
# 1.9GB Split threshold (Telegram hard limit is 2GB for normal accounts)
SPLIT_THRESHOLD_BYTES=2040109465
# 500MB Streaming vs Temp storage threshold
STREAM_THRESHOLD_BYTES=524288000
